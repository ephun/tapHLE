/target
/build
/vendor/boost
/runtime/sandbox

# The desktop frontend's own state: which apps this machine knows about, how
# long they have been played, this user's ratings and window geometry. All of
# it is local, and the library file names the paths of a personal collection.
/runtime/frontend
# The settings both programs share. Local to this machine, and its per-app
# section names apps this person owns.
/runtime/settings.json
/runtime/apps/*
!/runtime/apps/README.txt
*.ipa
log.txt
runtime/wallpaper.*

# Frontier surveys (dev-scripts/survey.py) and import scans
# (dev-scripts/demand.py) list the apps in a personal collection. Share the
# findings, never the file.
*frontier-survey*.jsonl
*.survey.jsonl
*import-demand*.jsonl

# Legacy runtime data from pre-fork builds must never be committed.
/touchHLE_sandbox
/touchHLE_apps
touchHLE_log.txt
touchHLE_wallpaper.*

# Android

*.iml
.gradle
/local.properties
.idea/
/captures
.externalNativeBuild
.cxx
local.properties
android/app/src/main/jniLibs
android/app/build
android/build

# macOS

.DS_Store

# Default developer dump file

DUMP.txt

# Python tooling caches

__pycache__/
*.py[cod]
