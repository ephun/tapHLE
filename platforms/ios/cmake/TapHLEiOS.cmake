if(NOT DEFINED ENV{TAPHLE_BOOST_ROOT})
    message(FATAL_ERROR "TAPHLE_BOOST_ROOT is required")
endif()
if(NOT DEFINED ENV{TAPHLE_IOS_ARCH})
    message(FATAL_ERROR "TAPHLE_IOS_ARCH is required")
endif()
set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_SYSTEM_PROCESSOR "$ENV{TAPHLE_IOS_ARCH}")
set(CMAKE_OSX_ARCHITECTURES "$ENV{TAPHLE_IOS_ARCH}" CACHE STRING "iOS architecture" FORCE)
set(CMAKE_OSX_DEPLOYMENT_TARGET 17.0 CACHE STRING "Minimum iOS version" FORCE)
if(DEFINED ENV{SDKROOT})
    set(CMAKE_OSX_SYSROOT "$ENV{SDKROOT}" CACHE PATH "Apple SDK" FORCE)
endif()
set(Boost_INCLUDE_DIR "$ENV{TAPHLE_BOOST_ROOT}" CACHE PATH "Boost headers" FORCE)
set(CMAKE_POLICY_DEFAULT_CMP0167 OLD)
set(CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED NO)
